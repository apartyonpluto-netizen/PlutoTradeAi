# PlutoTradeAI_v02 environment template
# Only include non-secret defaults/placeholders.

# Provider configuration (TradingView-first architecture)
PLUTO_SIGNAL_PROVIDER=tradingview
PLUTO_CHART_PROVIDER=tradingview
PLUTO_MARKET_PROVIDER=yfinance
PLUTO_PAPER_BROKER=internal
PLUTO_EXECUTION_PROVIDER=disabled

# Market data cache settings
PLUTO_MARKET_CACHE_SECONDS=30
PLUTO_MARKET_STALE_SECONDS=300
PLUTO_MARKET_POLL_SECONDS=15

# Internal paper trading controls
PLUTO_PAPER_STARTING_BALANCE=100000
PLUTO_MAX_RISK_PER_TRADE=0.01
PLUTO_MAX_POSITION_PERCENT=0.10
# Reject an approval when the live price is this many percent away from the signal entry (0 disables)
PLUTO_MAX_ENTRY_DEVIATION_PERCENT=3.0
# Simulated commission per share, charged on every fill (entry and exit)
PLUTO_PAPER_FEE_PER_SHARE=0
# NOTE: auto execution is NOT implemented - every entry needs a human approval. Keep false.
PLUTO_AUTO_PAPER_EXECUTION=false
PLUTO_AUTONOMY_ENABLED=true
PLUTO_ORDER_MONITOR_INTERVAL_SECONDS=45
PLUTO_ENABLE_ORDER_MONITOR=true
# Optional token that lets a scheduler call POST /api/paper/monitor/run (header X-Pluto-Monitor-Token)
PLUTO_MONITOR_TRIGGER_TOKEN=

# State storage. Every state file (signals, approvals, paper ledger, simulated broker, users) lives in
# PLUTO_DATA_DIR. On Render this MUST be a mounted persistent disk or the ledger is lost on every deploy.
PLUTO_DATA_DIR=data
# Individual overrides (rarely needed): PLUTO_SIGNALS_FILE, PLUTO_SIGNAL_APPROVALS_FILE,
# PLUTO_PAPER_LEDGER_FILE (the simulated broker file is <ledger>.broker.json)

# Signal workflow
# A signal not approved within this many seconds of receipt expires (0 disables)
PLUTO_SIGNAL_APPROVAL_MAX_AGE_SECONDS=3600
PLUTO_SIGNAL_ANALYSIS_TIMEOUT_SECONDS=180
PLUTO_MAX_REQUEST_BYTES=262144

# TradingView webhook security
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_WEBHOOK_MAX_AGE_SECONDS=300

# Alpaca live stream (optional/inactive unless explicitly enabled)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_FEED=iex
ALPACA_WS_URL=

# Process role & background worker control (active)
PLUTO_ROLE=web
PLUTO_ENABLE_WORKER=true
PLUTO_REFRESH_INTERVAL_SECONDS=600

# Session/security settings (active)
# REQUIRED in production: without it a random key is generated per process, so every restart signs everyone out.
PLUTO_SECRET_KEY=replace-with-a-long-random-secret
# Approve/decline/alert/monitor actions need a signed-in user. Registration is open by default:
# set PLUTO_ALLOW_REGISTRATION=false after creating your account, and/or restrict who may approve.
PLUTO_ALLOW_REGISTRATION=true
PLUTO_APPROVER_USERS=
PLUTO_SESSION_DAYS=7
PLUTO_SESSION_SAMESITE=Lax
PLUTO_SESSION_SECURE=false
# PLUTO_ADMIN_MODE=true treats EVERY visitor as signed in. Never enable it on a public deployment.
PLUTO_ADMIN_MODE=false

# Runtime/server settings (active)
PORT=8000
FLASK_DEBUG=false

# Bearer-token environment variables
# NOTE: Not currently read by active backend code in this repository snapshot.
X_BEARER_TOKEN=
X_API_BEARER_TOKEN=

# Inactive / future-only variables (not currently read by active backend)
PUBLIC_PREVIEW=
LIVE_TRADING_ENABLED=
ETRADE_ENABLED=
WEBULL_PAPER_MODE=
