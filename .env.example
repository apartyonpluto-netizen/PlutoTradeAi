# Required in production - without this, a random secret is generated and
# saved to data/.flask_secret_key on first boot. On a host with an ephemeral
# filesystem that file (and therefore every logged-in session) gets wiped on
# every redeploy/restart. Set this explicitly and everyone stays logged in
# across deploys. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Shared secret the hosting platform's scheduled job (Render Cron Job,
# Railway cron, etc.) sends as the X-Cron-Secret header when it calls
# POST /api/autonomy/cron-trigger to run the autonomous scan for every user
# currently in AUTONOMOUS mode. Leave unset and that endpoint stays disabled.
# Generate one the same way as FLASK_SECRET_KEY.
CRON_SECRET=

# Where per-user data (accounts, trades, credentials, settings) is stored.
# Must point at a persistent volume/disk - most PaaS free tiers use an
# ephemeral filesystem that wipes on every deploy, which would delete every
# registered user's account and trade history. Leave unset to use ./data
# relative to the app.
PLUTO_DATA_DIR=

# Set by most hosting platforms automatically - only set manually for local
# testing on a non-default port.
PORT=

# 1 to enable Flask's debug mode (auto-reload + interactive debugger).
# Never enable in production - the debugger allows remote code execution.
FLASK_DEBUG=0

# Set to 1 once deployed behind HTTPS (every PaaS gives you this by default)
# to mark the session cookie Secure - keeps it off locally since a Secure
# cookie is refused by the browser over plain http://localhost.
FORCE_SECURE_COOKIES=0

# Optional - powers the real Alpaca news provider in news/news_service.py
# (backend/integrations/alpaca.py). Without these, the news feed falls back
# to obviously-labeled demo content instead of an empty feed.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
